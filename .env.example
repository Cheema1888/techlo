# TECHLO Environment Configuration Example

# Durable PostgreSQL connection (Neon, Supabase, Prisma Postgres, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# App Canonical URL
NEXT_PUBLIC_APP_URL="https://techlo.pk"

# Google Identity Services OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Security Secrets
JWT_SECRET="your-jwt-secret-key"
NEXTAUTH_SECRET="your-nextauth-secret-key"

# ----------------------------------------------------
# SMS OTP GENERATOR & DISPATCH GATEWAY CONFIGURATION
# ----------------------------------------------------
# Supported Providers:
# 1. 'local'    -> Logs OTP codes to server terminal & displays in-app helper for rapid development
# 2. 'twilio'   -> Sends official SMS via Twilio API
# 3. 'brandsms' -> Sends official branded SMS via Pakistani Telco Gateway (BrandSMS.pk, Jazz, Telenor)
SMS_PROVIDER="local"

# Twilio SMS API Keys (Required only if SMS_PROVIDER="twilio")
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"

# Pakistani Branded SMS Gateway (Required only if SMS_PROVIDER="brandsms")
BRAND_SMS_API_KEY="your-brandsms-api-key"
BRAND_SMS_SENDER_ID="TECHLO"

# Environment
NODE_ENV="production"

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="techlo-product-images"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
