# TECHLO Production Environment Configuration

# Database Connection (SQLite locally, PostgreSQL in Production)
DATABASE_URL="file:./dev.db"

# App URL (Canonical domain for SEO and OpenGraph metadata)
NEXT_PUBLIC_APP_URL="https://techlo.pk"

# Security & Secret
JWT_SECRET="techlo-pakistan-secure-secret-token-key-2026"
NEXTAUTH_SECRET="techlo-pakistan-auth-secure-random-key"

# ----------------------------------------------------
# SMS OTP GENERATOR & DISPATCH GATEWAY CONFIGURATION
# ----------------------------------------------------
# Options: 'local' (console & in-app dev testing), 'twilio' (Twilio API), 'brandsms' (Pakistani Telcos / BrandSMS.pk)
SMS_PROVIDER="local"

# 1. Twilio SMS Configuration (Optional - for global & Pakistan SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# 2. Pakistan Telco / BrandSMS.pk Configuration (Optional - for direct Jazz/Telenor/Zong branded SMS)
BRAND_SMS_API_KEY=""
BRAND_SMS_SENDER_ID="TECHLO"

# Environment
NODE_ENV="development"
