# TECHLO Production Environment Configuration

# Database Connection (SQLite locally, PostgreSQL in Production)
DATABASE_URL="file:./dev.db"

# App URL (Canonical domain for SEO and OpenGraph metadata)
NEXT_PUBLIC_APP_URL="https://techlo.pk"

# Security & Secret
JWT_SECRET="techlo-pakistan-secure-secret-token-key-2026"
NEXTAUTH_SECRET="techlo-pakistan-auth-secure-random-key"

# Environment
NODE_ENV="production"
